# Image Gen MCP configuration
#
# Copy this file to a local env file or export only the variables for the
# providers you want to use. Providers without keys are skipped automatically.

# Optional defaults
IMAGE_GEN_DEFAULT_PROVIDER=openai
IMAGE_GEN_OUTPUT_DIR=~/Downloads/generated-images
# IMAGE_GEN_INPUT_ROOT=/absolute/path/to/allowed-inputs
IMAGE_GEN_RUN_RETENTION_HOURS=24
# MCP_SSE_PORT=3101

# Text-to-image providers
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-image-1
OPENAI_EDIT_MODEL=gpt-image-1.5
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
TOGETHER_API_KEY=
XAI_API_KEY=

# Capability-only providers
PHOTOROOM_API_KEY=
FAL_KEY=
IDEOGRAM_API_KEY=

# Required for planner-backed image_task calls.
# Template fast paths can run before planner use without this key.
ANTHROPIC_API_KEY=
